# Server Port
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB URI or leave blank/'memory' for in-memory MongoDB)
MONGODB_URI=mongodb://localhost:27017/emmbros

# Authentication & JWT Configuration
JWT_SECRET=emmbros_super_secret_jwt_key_2026_change_in_production

# Initial Admin Seed Credentials (used by npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@emmbrosautocomp.com
ADMIN_PASSWORD=Admin@12345

# SMTP Configuration for Contact Form & Job Application Notifications
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Form Email Routing & Admin Notifications
MAIL_TO=enquiry@emmbros.com
MAIL_FROM=website@emmbros.com
ADMIN_NOTIFICATION_EMAIL=careers@emmbros.com
