# Copy to .env and fill in real SMTP credentials to enable email sending.
PORT=4000

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where form submissions are delivered, and the From header.
MAIL_TO=enquiry@emmbros.com
MAIL_FROM=website@emmbros.com
